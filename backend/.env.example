NODE_ENV=development
PORT=8787
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=info

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
DEVICE_JWT_EXPIRES_IN=1h

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sitsync_db
DB_USER=postgres
DB_PASSWORD=replace-me
DB_TLS=false
DB_TLS_REJECT_UNAUTHORIZED=true

ML_URL=http://localhost:8000
ML_TIMEOUT_MS=2000
ML_TRAINING_TIMEOUT_MS=900000

# Feature-only personalization collection and retention safeguards.
PERSONALIZATION_SAMPLE_INTERVAL_MS=100
PERSONALIZATION_MINIMUM_SAMPLE_INTERVAL_MS=80
PERSONALIZATION_SEQUENCE_FRAMES=200
PERSONALIZATION_CONTINUITY_GAP_MS=2000
PERSONALIZATION_MAX_FRAMES_PER_DAY=36000
PERSONALIZATION_MAX_SEQUENCES_PER_USER=500
PERSONALIZATION_RETENTION_DAYS=30
PERSONALIZATION_TRAINING_MAX_SEQUENCES=200

WS_MAX_MESSAGE_BYTES=65536
WS_MESSAGES_PER_MINUTE=900
WS_AUTH_TIMEOUT_MS=5000
WS_HEARTBEAT_MS=30000

# Bootstrap credentials when a devices DB row is not yet available.
# Prefer credentialHash="sha256:<64 hex chars>"; never commit real secrets.
DEVICE_CREDENTIALS_JSON={"device-01":{"userId":"00000000-0000-4000-8000-000000000001","credentialHash":"sha256:replace-with-64-hex-characters"}}

RECORDING_DIR=../ml-service/data/raw/real
RAW_RECORDING_CHUNK_FRAMES=100
RAW_RECORDING_RETENTION_DAYS=30
