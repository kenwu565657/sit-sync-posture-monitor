{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "seed:demo": "node dist/seedDemoUser.js",
    "seed": "node --import tsx seed.ts",
    "seed:replay": "node --import tsx seed-replay.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose -f ../docker-compose.local.yml up -d postgres",
    "infra:down": "docker compose -f ../docker-compose.local.yml stop postgres",
    "infra:status": "docker compose -f ../docker-compose.local.yml ps postgres",
    "infra:logs": "docker compose -f ../docker-compose.local.yml logs -f postgres"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
