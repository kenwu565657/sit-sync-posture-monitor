# Local simulator defaults may use http:// and ws://. Release builds require TLS.
SITSYNC_HTTP_URL=https://api.example.com
SITSYNC_WS_URL=wss://realtime.example.com
SITSYNC_ALLOW_INSECURE_HTTP=false

# Users sign in inside the app. The backend automatically enrolls this app
# installation as a gateway after login; no device credential is configured here.

# These names must exactly match the four firmware BLE names.
SITSYNC_BLE_NECK_NAME=SitSync-Neck
SITSYNC_BLE_LOWER_BACK_NAME=SitSync-LowerBack
SITSYNC_BLE_LEFT_SHOULDER_NAME=SitSync-LeftShoulder
SITSYNC_BLE_RIGHT_SHOULDER_NAME=SitSync-RightShoulder
