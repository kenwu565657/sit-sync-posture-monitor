# Copy this file to .env.demo and replace EC2_PUBLIC_IP.
# This cleartext mode is only for a short-lived EC2 demonstration.
SITSYNC_HTTP_URL=http://EC2_PUBLIC_IP:8787
SITSYNC_WS_URL=ws://EC2_PUBLIC_IP:8787
SITSYNC_ALLOW_INSECURE_HTTP=true

SITSYNC_BLE_NECK_NAME=SitSync-Neck
SITSYNC_BLE_LOWER_BACK_NAME=SitSync-LowerBack
SITSYNC_BLE_LEFT_SHOULDER_NAME=SitSync-LeftShoulder
SITSYNC_BLE_RIGHT_SHOULDER_NAME=SitSync-RightShoulder
